# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1h

# Administrative Account Credentials
ADMIN_EMAIL=admin@devconsult.com
ADMIN_PASSWORD=change_this_admin_password_in_production
ADMIN_NAME=Administrator

# Production Database (Optional - Netlify Serverless Persistence)
# If omitted or unavailable, gracefully falls back to local memory/JSON store
# Example Neon/Supabase PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true
